PORT=8787
PUBLIC_URL=http://localhost:8787
WEB_ORIGIN=http://localhost:3000
TOOL_SECRET=replace-with-a-long-random-string
# Shared by the iPhone app and the /line page (NEXT_PUBLIC_APP_KEY in web/)
APP_KEY=dev-app-key-change-me
ASK_TIMEOUT_MS=25000

MONGODB_URI=
MONGODB_DB=matilda

GEMINI_API_KEY=
# Tried in order; if every model fails, a keyword matcher answers
GEMINI_MODELS=gemini-3.5-flash-lite,gemini-2.5-flash-lite,gemini-2.5-flash

ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_LLM=gemini-3.5-flash
# Adds "I'm an AI voice, and this call is transcribed." to the greeting. Turn on for real calls.
DISCLOSE_AI=false

SSOJET_ISSUER=
# Checked as the token audience when set
SSOJET_CLIENT_ID=

# Local lip-reading service (lipread/), runs on the same machine
LIPREAD_URL=http://localhost:8790
